test huge_lists = do
  xs = (0..big_n()).map(i => i % 1000)
  dedup(xs).len == big_n() and distinct_by(xs, x => x).len == 1000 and sliding(xs, 10, 10, false).len == big_n() / 10 and split_parts(xs, 7).fold(0, (n, p) => n + p.len) == big_n() and is_sorted(merge_all(split_parts(xs.sort, 4))) and frequencies(xs).get(5) == some(100) and top_k(xs, 3, x => x) == [999, 999, 999] and partition_point(xs.sort, _ < 500) == 50000 and interleave(xs, xs).len == 2 * big_n() and transpose([xs, xs]).len == big_n() and remove_at(xs, 50000).len == big_n() - 1 and index_of_sublist(xs, [998, 999, 0]) == some(998) and union(xs, xs).len == 1000 and multi_difference(xs, xs).len == 0

type Desc = {n: Int} derive Eq, Show

impl Ord for Desc
  fn cmp(a: Desc, b: Desc) -> Int
  = b.n - a.n

fn descs(ns: List[Int]) -> List[Desc]
= ns.map(n => Desc{n})

test custom_ord_is_used = is_sorted(descs([3, 2, 2, 1])) and not is_sorted(descs([1, 2])) and dense_ranks(descs([1, 3, 2, 3])) == [2, 0, 1, 0] and largest(descs([1, 3, 2]), 1) == descs([1]) and merge_all([descs([5, 1]), descs([4, 2])]) == descs([5, 4, 2, 1]) and compare_lists(descs([2]), descs([1])) == -1 and min_max(descs([1, 3, 2])) == some((Desc{n: 3}, Desc{n: 1}))
